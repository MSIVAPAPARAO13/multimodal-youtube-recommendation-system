# Application Configuration
APP_ENV=development
ALLOW_UNINITIALIZED_MODEL=true
MODEL_PATH=checkpoints/best.pt
RESNET_BACKBONE=resnet50
WAV2VEC2_MODEL=facebook/wav2vec2-base-960h
BERT_MODEL=bert-base-uncased
FUSION_TYPE=gated
FEATURE_DIM=512
PRETRAINED_FOUNDATION=true
DETERMINISTIC_INFERENCE=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_MEDIA_DIRS=data,videos,tests

# YouTube Data API v3 Configuration
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
YOUTUBE_API_TIMEOUT=10.0
YOUTUBE_API_ENABLED=true

# YouTube Media & Ingestion Configuration (Phase 4)
MEDIA_STORAGE_DIR=data/raw/youtube
MAX_VIDEO_SIZE_MB=100
MAX_AUDIO_SIZE_MB=50
MAX_VIDEO_DURATION_SECONDS=600
THUMBNAIL_MAX_SIZE_MB=10
YT_DLP_ENABLED=true
YT_DLP_TIMEOUT=60.0
INGESTION_MAX_RETRIES=3
TRANSCRIPT_ENABLED=true

# Database Configuration (Canonical port: 5432)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=video_recommender

# Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
