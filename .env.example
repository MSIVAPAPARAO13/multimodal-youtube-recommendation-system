# Application & Server Configuration
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
ALLOW_UNINITIALIZED_MODEL=true
MODEL_PATH=data/checkpoints/EXP_MICROLENS_TEXT_COENGAGEMENT_V2/best.pt
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
ALLOWED_MEDIA_DIRS=data,videos,tests

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=video_recommender
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# AI Pipeline & Vector Search (Phases 8C, 9, 10, 11A, 11B)
RECOMMENDATION_MODE=TEXT_COENGAGEMENT_V2
PHASE_8C_CHECKPOINT_PATH=data/checkpoints/EXP_MICROLENS_TEXT_COENGAGEMENT_V2/best.pt
VECTOR_SEARCH_BACKEND=auto
VECTOR_DEFAULT_TOP_K=10
VECTOR_MAX_TOP_K=50
VECTOR_HNSW_M=16
VECTOR_HNSW_EF_CONSTRUCTION=64
VECTOR_HNSW_EF_SEARCH=40
RERANKING_ENABLED=false

# Foundation Models & Encoders
BERT_MODEL=bert-base-uncased
RESNET_BACKBONE=resnet50
WAV2VEC2_MODEL=facebook/wav2vec2-base-960h
FEATURE_DIM=512
PRETRAINED_FOUNDATION=true
DETERMINISTIC_INFERENCE=true

# YouTube Data API v3 & Ingestion Configuration (Phase 4, 12A, 13)
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
YOUTUBE_API_TIMEOUT=10.0
YOUTUBE_API_ENABLED=true
MEDIA_STORAGE_DIR=data/raw/youtube
MAX_VIDEO_SIZE_MB=100
MAX_AUDIO_SIZE_MB=50
MAX_VIDEO_DURATION_SECONDS=600
THUMBNAIL_MAX_SIZE_MB=10
YT_DLP_ENABLED=true
INGESTION_CONCURRENCY=4

# Frontend Configuration (Vite React)
VITE_API_BASE_URL=http://localhost:8000
