# Streamlit Cloud Secrets Configuration Template
# Configure these in Streamlit Community Cloud (App Settings > Secrets)

# 1. Separately deployed FastAPI backend URL (Optional)
# If provided, Streamlit proxies candidate retrieval and recommendations to this service.
# API_BASE_URL = "https://your-api-domain.com"
# FASTAPI_URL = "https://your-api-domain.com"

# 2. Managed PostgreSQL + pgvector connection string (Optional)
# If provided, Streamlit queries PostgreSQL directly (Neon, Supabase, AWS RDS, Render).
# DATABASE_URL = "postgresql://postgres:password@your-db-host:5432/video_recommender"

# 3. YouTube Data API v3 Key (Optional)
# Used only if live YouTube video metadata enrichment is enabled.
# YOUTUBE_API_KEY = "your-youtube-api-key"
